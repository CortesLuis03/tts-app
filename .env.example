# Clave de OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx

# Opcionales
# MODELO_POR_DEFECTO=openai/gpt-4o-mini-tts-2025-12-15
# MAX_TEXT_CHARS=20000

# --- Despliegue con Docker + Traefik (docker-compose.yml) ---
# Usuario:hash bcrypt/apr1. Genera con: htpasswd -nb usuario clave   (duplica cada $ como $$ en este archivo)
TTS_BASIC_AUTH=admin:$$apr1$$REEMPLAZA$$ESTE_HASH

# Opcional: imagen del registro (si la subiste con docker push)
# TTS_IMAGE=TU_USUARIO/tts-app:latest

# Interfaz donde se publica el puerto 9002 (127.0.0.1 = solo el propio VPS)
# TTS_BIND=127.0.0.1
